{
  "name": "MagicMirror Dev",
  "dockerComposeFile": "../compose.yml",
  "service": "magicmirror",
  "runServices": ["magicmirror"],
  "workspaceFolder": "/opt/magic_mirror/",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "containerEnv": {
    "IN_DEVCONTAINER": "1",
    "DOCKER_CONTAINER_NAME": "magicmirror-dev",
    "PLAYWRIGHT_CHROMIUM_ARGS": "--no-sandbox --disable-dev-shm-usage --disable-gpu"
  },

  "portsAttributes": {
    "8080": {
      "label": "MagicMirror",
      "onAutoForward": "notify"
    }
  },
  // The host's Claude Code config is mounted read-only so the container can inherit
  // the login. Runtime bind mount: nothing lands in the image, and the path below is
  // all that is committed. Read-only on purpose - the container runs as root, so a
  // writable mount would leave root-owned files in the host's ~/.claude.
  // postStartCommand copies the credentials into the container's own ~/.claude.
  "mounts": ["source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/tmp/host-claude,type=bind,readonly"],


  "customizations": {
    "vscode": {
      // All extensions come from this repo's own image (devcontainer.metadata label in
      // docker/Dockerfile) and are merged in automatically.
      "extensions": [],
      "settings": {
        "chat.mcp.autoStart": true,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },

  "postCreateCommand": "true",
  "postStartCommand": "mkdir -p /tmp/playwright-mcp; mkdir -p /root/.claude; if [ -f /tmp/host-claude/.credentials.json ]; then cp /tmp/host-claude/.credentials.json /root/.claude/.credentials.json && chmod 600 /root/.claude/.credentials.json && echo 'Claude Code credentials inherited from host'; else echo 'No host Claude Code credentials found - run: claude login'; fi; echo 'Devcontainer started. App at http://localhost:8080'; echo 'Playwright MCP: .mcp.json (Claude Code) and .vscode/mcp.json (Copilot Chat)'"
}